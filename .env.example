DISCORD_TOKEN=
# shown to Tempus in the User-Agent so they can reach you, e.g. discord: yourname
CONTACT=

# discord
GUILD_ID=
STATUS_CHANNEL_NAME=tempus-status
STATUS_CHANNEL_ID=
# new world records go to every server with this channel; empty turns the feed off
RECORDS_CHANNEL_NAME=tempus-records
# also post new top-10 map times
RECORDS_INCLUDE_TOPS=false
# clickable Connect link; {addr} becomes ip:port. Empty hides the links
CONNECT_URL=https://tf2sa-clips.co.za/connect#{addr}
# extra /status users, comma separated
ADMIN_USER_IDS=

# tempus api, at most 1 request per second across the whole bot
POLL_INTERVAL_SECONDS=30
MAPS_REFRESH_HOURS=24
ACTIVITY_INTERVAL_MINUTES=5
RANK_TTL_HOURS=24
RANK_LOOKUP_SECONDS=2
REQUEST_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=20

# history
SNAPSHOT_INTERVAL_MINUTES=5
HISTORY_KEEP_DAYS=120

DB_PATH=tempus.db
LOG_LEVEL=INFO
LOG_FILE=tempus.log
